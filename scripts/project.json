{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "tooling",
  "root": "scripts",
  "projectType": "library",
  "tags": ["scope:tooling"],
  "implicitDependencies": ["desktop", "runtime", "shared", "pi-extensions", "site", "schema"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "eslint .",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "vitest run",
        "cwd": "."
      },
      "configurations": {
        "inventory": {
          "command": "vitest list --filesOnly --json"
        }
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "./scripts/validate.sh",
        "cwd": "."
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "prettier --check .",
        "cwd": "."
      }
    },
    "test:graph": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "vitest run scripts/nx-projects.test.ts",
        "cwd": "."
      }
    }
  }
}
