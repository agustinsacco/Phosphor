{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "site",
  "root": "apps/site",
  "projectType": "application",
  "tags": ["scope:site"],
  "implicitDependencies": ["desktop", "tooling"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "npm run build",
        "cwd": "apps/site"
      },
      "outputs": ["{projectRoot}/dist", "{projectRoot}/public/og.png"]
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "npm run check",
        "cwd": "apps/site"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "npm test",
        "cwd": "apps/site"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "npm run dev",
        "cwd": "apps/site"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "npm run start",
        "cwd": "apps/site"
      }
    },
    "prebuild": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "npm run prebuild",
        "cwd": "apps/site"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "npm run preview",
        "cwd": "apps/site"
      }
    },
    "shots": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "npm run shots",
        "cwd": "apps/site"
      }
    },
    "shots:guides": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "npm run shots:guides",
        "cwd": "apps/site"
      }
    },
    "audit:links": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "npm run audit:links",
        "cwd": "apps/site"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "npm run format",
        "cwd": "apps/site"
      }
    }
  }
}
