{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "analytics": false,
  "useDaemonProcess": false,
  "useInferencePlugins": false,
  "plugins": [],
  "parallel": 3,
  "tui": {
    "enabled": false
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "workspace": ["{workspaceRoot}/**/*", "!{workspaceRoot}/.nx/**/*"]
  },
  "targetDefaults": {
    "nx:run-commands": {
      "cache": false,
      "inputs": ["workspace"]
    }
  },
  "cacheDirectory": ".nx/cache"
}
